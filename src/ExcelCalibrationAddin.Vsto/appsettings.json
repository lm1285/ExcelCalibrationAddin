{
  "Backend": {
    "BaseUrl": "http://localhost:3002",
    "TemplateApiPrefix": "/api/excel-templates"
  },
  "Cache": {
    "SqliteFile": "%LOCALAPPDATA%\\ExcelCalibrationAddin\\cache.db"
  },
  "Generation": {
    "GenerateShortcutKey": "F6",
    "DefaultDistribution": "Normal",
    "ResultCalculationMethod": "FormulaBackCalculation",
    "StandardValueReference": "RecognizedStandardValueRange",
    "UseSameDeviationDirection": true,
    "UseIndependentDeviationControl": true,
    "UnifiedErrorMinimumCoefficient": 0.2,
    "UnifiedErrorMaximumCoefficient": 0.8,
    "PositiveErrorMinimumCoefficient": 0.2,
    "PositiveErrorMaximumCoefficient": 0.8,
    "NegativeErrorMinimumCoefficient": 0.2,
    "NegativeErrorMaximumCoefficient": 0.8,
    "AbsoluteErrorMinimumCoefficient": 0.2,
    "AbsoluteErrorMaximumCoefficient": 0.8,
    "MinimumRequirementMinimumCoefficient": 1.05,
    "MinimumRequirementMaximumCoefficient": 1.3,
    "MeasurementGroupMinimumFluctuationCoefficient": 0.01,
    "MeasurementGroupMaximumFluctuationCoefficient": 0.06,
    "ResultGroupMinimumFluctuationCoefficient": 0.0,
    "ResultGroupMaximumFluctuationCoefficient": 0.2,
    "ResponseTimeThresholdSeconds": 180,
    "ResponseTimeBelowThresholdMaximumDifferenceSeconds": 5,
    "ResponseTimeAboveThresholdMaximumDifferenceSeconds": 7
  }
}
